+#[cfg(test)]
+mod baseline_tests {
+    use super::*;
+
+    #[test]
+    fn baseline_only_changes_for_mixed_fonts() {
+        let layout = LineLayout {
+            runs: vec![
+                crate::ShapedRun {
+                    font_id: crate::FontId(1),
+                    glyphs: Vec::new(),
+                },
+                crate::ShapedRun {
+                    font_id: crate::FontId(1),
+                    glyphs: Vec::new(),
+                },
+            ],
+            ..Default::default()
+        };
+        assert!(!has_mixed_fonts(&layout));
+
+        let mixed = LineLayout {
+            runs: vec![
+                layout.runs[0].clone(),
+                crate::ShapedRun {
+                    font_id: crate::FontId(2),
+                    glyphs: Vec::new(),
+                },
+            ],
+            ..Default::default()
+        };
+        assert!(has_mixed_fonts(&mixed));
+    }
+}
+
+#[cfg(all(test, target_os = "windows"))]
+mod windows_baseline_tests {
+    use super::*;
+    use crate::{Font, FontRun, FontWeight, PlatformTextSystem};
+
+    #[test]
+    fn windows_baseline_is_stable_when_editing_cjk_text() {
+        let devices = crate::platform::DirectXDevices::new().unwrap();
+        let system = Arc::new(crate::platform::DirectWriteTextSystem::new(&devices).unwrap());
+        let text_system = crate::TextSystem::new(system.clone());
+        let cjk = "\u{4e2d}\u{6587}\u{6bb5}\u{843d}";
+        let edits = [
+            cjk.to_string(),
+            format!("a{cjk}"),
+            format!("\u{4e2d}a\u{6587}\u{6bb5}\u{843d}"),
+            format!("{cjk}a"),
+            format!("{cjk}\u{1f600}"),
+            cjk.to_string(),
+        ];
+        for family in ["Segoe UI", "Consolas"] {
+            for weight in [FontWeight::NORMAL, FontWeight::BOLD] {
+                let font_id = system
+                    .font_id(&Font {
+                        weight,
+                        ..crate::font(family)
+                    })
+                    .unwrap();
+                let metrics = system.font_metrics(font_id);
+                for font_size in [px(15.0), px(24.0), px(32.0)] {
+                    let expected_ascent = metrics.ascent(font_size);
+                    let expected_descent = -metrics.descent(font_size);
+                    for text in &edits {
+                        let layout = system.layout_line(
+                            text,
+                            font_size,
+                            &[FontRun { len: text.len(), font_id }],
+                        );
+                        assert!(!layout.runs.is_empty(), "native shaping must execute");
+                        assert_eq!(
+                            (layout.ascent, layout.descent),
+                            (expected_ascent, expected_descent),
+                            "baseline metrics changed for {family} {weight:?} {font_size:?}: {text}"
+                        );
+                        for line_height in [font_size, font_size * 1.6, font_size * 2.0] {
+                            assert_eq!(
+                                line_baseline_offset(&layout, line_height, &text_system).y,
+                                (line_height + expected_ascent - expected_descent) / 2.0,
+                                "painted baseline changed for {family}: {text}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
