+    fn instance_view(
+        &mut self,
+        device: &ID3D11Device,
+        start: usize,
+    ) -> Result<[Option<ID3D11ShaderResourceView>; 1]> {
+        if start == 0 {
+            return Ok(self.view.clone());
+        }
+        anyhow::ensure!(
+            start < self.buffer_size,
+            "instance view starts beyond its buffer"
+        );
+        if let Some(view) = self.instance_views.get(&start) {
+            return Ok(view.clone());
+        }
+        // Views reference this buffer only and are invalidated on growth.
+        // Bound retained views while scrolling exposes different batch offsets.
+        const MAX_INSTANCE_VIEWS: usize = 1024;
+        if self.instance_views.len() >= MAX_INSTANCE_VIEWS {
+            self.instance_views.clear();
+        }
+        let description = D3D11_SHADER_RESOURCE_VIEW_DESC {
+            Format: DXGI_FORMAT_UNKNOWN,
+            ViewDimension: D3D_SRV_DIMENSION_BUFFER,
+            Anonymous: D3D11_SHADER_RESOURCE_VIEW_DESC_0 {
+                Buffer: D3D11_BUFFER_SRV {
+                    Anonymous1: D3D11_BUFFER_SRV_0 {
+                        FirstElement: u32::try_from(start)
+                            .context("instance view offset exceeds u32")?,
+                    },
+                    Anonymous2: D3D11_BUFFER_SRV_1 {
+                        NumElements: u32::try_from(self.buffer_size - start)
+                            .context("instance view length exceeds u32")?,
+                    },
+                },
+            },
+        };
+        let mut view = None;
+        unsafe {
+            device.CreateShaderResourceView(&self.buffer, Some(&description), Some(&mut view))
+        }?;
+        let view = [view];
+        self.instance_views.insert(start, view.clone());
+        Ok(view)
