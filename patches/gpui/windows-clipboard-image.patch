+#[cfg(test)]
+mod clipboard_image_tests {
+    use super::*;
+
+    fn make_dib_v3(width: i32, height: i32, bit_count: u16, pixels: &[u8]) -> Vec<u8> {
+        let mut dib = Vec::with_capacity(40 + pixels.len());
+        dib.extend_from_slice(&40u32.to_le_bytes()); // biSize
+        dib.extend_from_slice(&width.to_le_bytes());
+        dib.extend_from_slice(&height.to_le_bytes());
+        dib.extend_from_slice(&1u16.to_le_bytes()); // biPlanes
+        dib.extend_from_slice(&bit_count.to_le_bytes());
+        dib.extend_from_slice(&0u32.to_le_bytes()); // BI_RGB
+        dib.extend_from_slice(&(pixels.len() as u32).to_le_bytes());
+        dib.extend_from_slice(&0i32.to_le_bytes());
+        dib.extend_from_slice(&0i32.to_le_bytes());
+        dib.extend_from_slice(&0u32.to_le_bytes());
+        dib.extend_from_slice(&0u32.to_le_bytes());
+        dib.extend_from_slice(pixels);
+        dib
+    }
+
+    #[test]
+    fn dib_24bit_converts_to_png() {
+        let dib = make_dib_v3(1, 1, 24, &[10, 20, 30, 0]);
+        let png = dib_bytes_to_png(&dib).expect("24-bit DIB should decode");
+        let decoded = image::load_from_memory_with_format(&png, image::ImageFormat::Png)
+            .expect("output should be valid PNG")
+            .to_rgba8();
+        assert_eq!(decoded.dimensions(), (1, 1));
+        assert_eq!(decoded.get_pixel(0, 0).0, [30, 20, 10, 255]);
+    }
+
+    #[test]
+    fn dib_32bit_all_zero_alpha_becomes_opaque() {
+        let dib = make_dib_v3(1, 1, 32, &[40, 50, 60, 0]);
+        let png = dib_bytes_to_png(&dib).expect("32-bit DIB should decode");
+        let decoded = image::load_from_memory_with_format(&png, image::ImageFormat::Png)
+            .expect("output should be valid PNG")
+            .to_rgba8();
+        assert_eq!(decoded.dimensions(), (1, 1));
+        assert_eq!(decoded.get_pixel(0, 0).0, [60, 50, 40, 255]);
+    }
+
+    #[test]
+    fn truncated_dib_returns_none() {
+        assert!(dib_bytes_to_png(&[1, 2, 3]).is_none());
+        let mut bad_header = vec![0u8; 40];
+        bad_header[0..4].copy_from_slice(&100u32.to_le_bytes());
+        assert!(dib_bytes_to_png(&bad_header).is_none());
+    }
+}
