+
+fn has_mixed_fonts(layout: &LineLayout) -> bool {
+    let Some(first) = layout.runs.first() else {
+        return false;
+    };
+    layout
+        .runs
+        .iter()
+        .skip(1)
+        .any(|run| run.font_id != first.font_id)
+}
+
+fn stable_baseline_offset(line_height: Pixels, ascent: Pixels, descent: Pixels) -> Point<Pixels> {
+    let padding_top = (line_height - ascent - descent) / 2.;
+    point(px(0.), padding_top + ascent)
+}
+
+fn line_baseline_offset(
+    layout: &LineLayout,
+    line_height: Pixels,
+    text_system: &crate::TextSystem,
+) -> Point<Pixels> {
+    // DirectWrite layouts already carry stable metrics from the requested font.
+    if !cfg!(target_os = "windows") && has_mixed_fonts(layout) {
+        let run = &layout.runs[0];
+        stable_baseline_offset(
+            line_height,
+            text_system.ascent(run.font_id, layout.font_size),
+            text_system.descent(run.font_id, layout.font_size),
+        )
+    } else {
+        stable_baseline_offset(line_height, layout.ascent, layout.descent)
+    }
+}
