+
+// Keep key ownership independent of editor actions and composition callback timing.
+fn key_down_is_ime_owned(virtual_key: VIRTUAL_KEY, has_marked_text: bool) -> bool {
+    virtual_key == VK_PROCESSKEY || has_marked_text
+}
+
+#[cfg(test)]
+mod ime_key_ownership_tests {
+    use super::{
+        VK_BACK, VK_DELETE, VK_ESCAPE, VK_LEFT, VK_PROCESSKEY, VK_RETURN, VK_RIGHT, VK_SPACE,
+        VK_TAB, key_down_is_ime_owned,
+    };
+
+    #[test]
+    fn processed_key_stays_with_ime_after_preedit_is_cleared() {
+        assert!(key_down_is_ime_owned(VK_PROCESSKEY, true));
+        // Cancellation can remove the marked range before WM_KEYDOWN arrives.
+        assert!(key_down_is_ime_owned(VK_PROCESSKEY, false));
+    }
+
+    #[test]
+    fn processed_key_stays_with_ime_after_commit() {
+        // Enter/Space can commit before the processed key reaches the window.
+        assert!(key_down_is_ime_owned(VK_PROCESSKEY, false));
+        assert!(!key_down_is_ime_owned(VK_RETURN, false));
+        assert!(!key_down_is_ime_owned(VK_SPACE, false));
+    }
+
+    #[test]
+    fn active_preedit_owns_editing_and_navigation_keys() {
+        for key in [
+            VK_BACK, VK_DELETE, VK_RETURN, VK_LEFT, VK_RIGHT, VK_ESCAPE, VK_TAB,
+        ] {
+            assert!(key_down_is_ime_owned(key, true), "{key:?}");
+        }
+    }
+
+    #[test]
+    fn cancellation_leaves_no_token_to_swallow_the_next_key() {
+        assert!(key_down_is_ime_owned(VK_PROCESSKEY, false));
+        for key in [
+            VK_BACK, VK_DELETE, VK_RETURN, VK_LEFT, VK_RIGHT, VK_ESCAPE, VK_TAB,
+        ] {
+            assert!(!key_down_is_ime_owned(key, false), "{key:?}");
+        }
+    }
+}
