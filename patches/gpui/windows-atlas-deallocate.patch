+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{self as gpui, TestAppContext, img};
+    use image::{Frame, RgbaImage};
+
+    #[gpui::test]
+    fn drop_image_outside_draw_clears_rendered_scene_and_refreshes(cx: &mut TestAppContext) {
+        let render_image = Arc::new(RenderImage::new(SmallVec::from_elem(
+            Frame::new(RgbaImage::new(2, 2)),
+            1,
+        )));
+
+        struct ImageView(Arc<RenderImage>);
+        impl Render for ImageView {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                img(self.0.clone()).w(px(16.)).h(px(16.))
+            }
+        }
+
+        let image_for_view = render_image.clone();
+        let (_view, cx) = cx.add_window_view(|_, _| ImageView(image_for_view));
+
+        cx.update(|window, cx| {
+            assert!(!window.rendered_frame.scene.polychrome_sprites.is_empty());
+            assert!(!window.invalidator.is_dirty());
+
+            cx.drop_image(render_image.clone(), Some(window));
+
+            assert!(window.rendered_frame.scene.polychrome_sprites.is_empty());
+            assert!(window.invalidator.is_dirty());
+            assert!(window.refreshing);
+            window.present();
+        });
+
+        // `flush_effects` saw the refresh and redrew the scene cleanly.
+        cx.update(|window, _| {
+            assert!(!window.rendered_frame.scene.polychrome_sprites.is_empty());
+            assert!(!window.invalidator.is_dirty());
+        });
+
+        cx.cx.update(|cx| cx.drop_image(render_image, None));
+
+        cx.update(|window, _| {
+            assert!(!window.rendered_frame.scene.polychrome_sprites.is_empty());
+            assert!(!window.invalidator.is_dirty());
+        });
+    }
+}
