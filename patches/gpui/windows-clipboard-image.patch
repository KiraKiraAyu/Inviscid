+    }))
+}
+
+fn dib_bytes_to_png(dib: &[u8]) -> Option<Vec<u8>> {
+    if dib.len() < 40 {
+        return None;
+    }
+    let header_size = u32::from_le_bytes(dib[0..4].try_into().ok()?) as usize;
+    if header_size < 40 || header_size > dib.len() {
+        return None;
+    }
+    let bit_count = u16::from_le_bytes(dib[14..16].try_into().ok()?);
+    let compression = u32::from_le_bytes(dib[16..20].try_into().ok()?);
+    let clr_used = u32::from_le_bytes(dib[32..36].try_into().ok()?) as usize;
+
+    let color_table_bytes = if bit_count > 0 && bit_count <= 8 {
+        let entries = if clr_used == 0 {
+            1usize << bit_count
+        } else {
+            clr_used
+        };
+        entries.checked_mul(4)?
+    } else if header_size == 40 && compression == 3 {
+        12
+    } else if header_size == 40 && compression == 6 {
+        16
+    } else {
+        clr_used.checked_mul(4)?
+    };
+
+    let bf_size = 14u32.checked_add(u32::try_from(dib.len()).ok()?)?;
+    let pixel_offset = header_size.checked_add(color_table_bytes)?;
+    let bf_off_bits = 14u32.checked_add(u32::try_from(pixel_offset).ok()?)?;
+
+    let mut bmp = Vec::with_capacity(14 + dib.len());
+    bmp.extend_from_slice(b"BM");
+    bmp.extend_from_slice(&bf_size.to_le_bytes());
+    bmp.extend_from_slice(&0u32.to_le_bytes());
+    bmp.extend_from_slice(&bf_off_bits.to_le_bytes());
+    bmp.extend_from_slice(dib);
+
+    let mut img = image::load_from_memory_with_format(&bmp, image::ImageFormat::Bmp).ok()?;
+    if bit_count == 32 {
+        let mut rgba = img.to_rgba8();
+        if rgba.pixels().all(|pixel| pixel.0[3] == 0) {
+            for pixel in rgba.pixels_mut() {
+                pixel.0[3] = 255;
+            }
+        }
+        img = image::DynamicImage::ImageRgba8(rgba);
+    }
+
+    let mut png = Vec::new();
+    img.write_to(&mut std::io::Cursor::new(&mut png), image::ImageFormat::Png)
+        .ok()?;
+    Some(png)
+}
