+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{ImageId, RenderImageParams, platform::windows::DirectXDevices};
+    use std::borrow::Cow;
+
+    fn image_key(id: usize) -> AtlasKey {
+        AtlasKey::Image(RenderImageParams {
+            image_id: ImageId(id),
+            frame_index: 0,
+        })
+    }
+
+    #[test]
+    fn directx_atlas_reuses_deallocated_tiles_while_other_tiles_remain_live() {
+        let Ok(devices) = DirectXDevices::new() else {
+            return;
+        };
+        let atlas = DirectXAtlas::new(&devices.device, &devices.device_context);
+        let tile_size = Size {
+            width: DevicePixels(600),
+            height: DevicePixels(600),
+        };
+        let pinned_size = Size {
+            width: DevicePixels(256),
+            height: DevicePixels(256),
+        };
+        let tile_bytes = vec![0u8; 600 * 600 * 4];
+        let pinned_bytes = vec![0u8; 256 * 256 * 4];
+
+        // Pin one tile on the first 1024x1024 polychrome texture so it never hits refcount 0.
+        let pinned_key = image_key(1);
+        let pinned_tile = atlas
+            .get_or_insert_with(&pinned_key, &mut || {
+                Ok(Some((pinned_size, Cow::Borrowed(pinned_bytes.as_slice()))))
+            })
+            .unwrap()
+            .unwrap();
+
+        let initial_texture = pinned_tile.texture_id;
+        for step in 2..20 {
+            let key = image_key(step);
+            let tile = atlas
+                .get_or_insert_with(&key, &mut || {
+                    Ok(Some((tile_size, Cow::Borrowed(tile_bytes.as_slice()))))
+                })
+                .unwrap()
+                .unwrap();
+            assert_eq!(tile.texture_id, initial_texture);
+            atlas.remove(&key);
+        }
+
+        let live_textures = atlas
+            .0
+            .lock()
+            .polychrome_textures
+            .textures
+            .iter()
+            .filter(|slot| slot.is_some())
+            .count();
+        assert_eq!(live_textures, 1);
+
+        atlas.remove(&pinned_key);
+        let live_after_unpin = atlas
+            .0
+            .lock()
+            .polychrome_textures
+            .textures
+            .iter()
+            .filter(|slot| slot.is_some())
+            .count();
+        assert_eq!(live_after_unpin, 0);
+
+        let reused_key = image_key(99);
+        let reused_tile = atlas
+            .get_or_insert_with(&reused_key, &mut || {
+                Ok(Some((pinned_size, Cow::Borrowed(pinned_bytes.as_slice()))))
+            })
+            .unwrap()
+            .unwrap();
+        assert_eq!(reused_tile.texture_id, initial_texture);
+        assert!(atlas.get_texture_view(reused_tile.texture_id)[0].is_some());
+        atlas.remove(&reused_key);
+    }
+}
